#наследование
class Car:                        # Родительский класс
    def __init__(self, brand, speed):
        self.brand = brand
        self.speed = speed

    def info(self):
        print(f"{self.brand}, макс. скорость: {self.speed} км/ч")

class ElectricCar(Car):            # Дочерний класс
    def __init__(self, brand, speed, battery):
        super().__init__(brand, speed)  # вызов родителя
        self.battery = battery

    def charge_info(self):
        print(f"Батарея: {self.battery} кВтч")

tesla = ElectricCar("Tesla", 250, 100)
tesla.info()         # Tesla, макс. скорость: 250 км/ч
tesla.charge_info()  # Батарея: 100 кВтч


#переопределение методов родительского класса
class Animal:
    def speak(self):
        return "Животное издаёт звук"

class Dog(Animal):
    def speak(self):  # переопределение метода speak()
        return "Гав!"

class Cat(Animal):
    def speak(self):  # другое переопределение метода speak()
        return "Мяу!"

animals = [Animal(),Dog(), Cat()]
for animal in animals:
    print(animal.speak())


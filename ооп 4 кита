#полиморфизм
class Animal:
    def make_sound(self):
        print("Какой-то звук")

class Dog(Animal):
    def make_sound(self):          # переопределяем метод
        print("Гав!")

class Cat(Animal):
    def make_sound(self):          # переопределяем метод
        print("Мяу!")

class Duck(Animal):
    def make_sound(self):
        print("Кря!")

# Один цикл — работает для всех!
animals = [Dog(), Cat(), Duck()]
for animal in animals:
    animal.make_sound()   # Гав! / Мяу! / Кря!

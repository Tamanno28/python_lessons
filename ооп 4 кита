#абстракция
from abc import ABC, abstractmethod

class Vehicle(ABC):               # абстрактный класс
    @abstractmethod
    def move(self):               # абстрактный метод
        pass                      # реализации нет!

    @abstractmethod
    def stop(self):
        pass

class Car(Vehicle):
    def move(self):               # обязаны реализовать!
        print("Машина едет")

    def stop(self):
        print("Машина тормозит")

class Boat(Vehicle):
    def move(self):
        print("Лодка плывёт")

    def stop(self):
        print("Лодка останавливается")

v = Vehicle()   # TypeError! — нельзя создать абстрактный класс

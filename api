import requests

BASE = 'https://jsonplaceholder.typicode.com'

# 1. Один ресурс: пост номер 1
response = requests.get(f'{BASE}/posts/1', timeout=10)
print('Статус:', response.status_code)                 # 200 — всё хорошо
print('Тип ответа:', response.headers['Content-Type'])  # application/json...
post = response.json()                                  # JSON → словарь Python
print('Заголовок:', post['title'])
print('Номер автора (userId):', post['userId'])

# 2. Коллекция: все посты сразу
posts = requests.get(f'{BASE}/posts', timeout=10).json()  # список словарей
print('Всего постов:', len(posts))
for post in posts[:5]:
    print(post['id'], post['title'])

# 3. Ресурса, которого нет
response = requests.get(f'{BASE}/posts/9999', timeout=10)
print('Статус:', response.status_code)   
